# Supabase (auth + cloud favorites). Copy to `.env.local` for local dev.
# `.env.local` is gitignored; never commit real values.
#
# Both are browser-safe (the publishable key relies on row-level security).
# The SECRET key (sb_secret_…) is backend-only and must NOT live in any VITE_
# variable or committed file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# PostHog — anonymous, cookieless telemetry. Optional: leave unset and the app
# runs with no analytics. The project API key is a write-only ingestion key and
# is safe to ship in the public bundle (it cannot read data back). The personal
# API key (phx_…) is admin-only and must NEVER live in a VITE_ var or commit.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
# Optional ingestion host. Default is PostHog US cloud. Use
# https://eu.i.posthog.com for the EU cloud, or your own URL when self-hosting.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# gooners MCP server (local) — optional user login for comps + favorites.
# Public browse/search work without these. Local only; never commit real values.
GOONERS_EMAIL=you@example.com
GOONERS_PASSWORD=your-gooners-password
