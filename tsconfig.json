{
  // TypeScript harness. `checkJs` is ON: every .js/.jsx is type-checked unless
  // it opts out with `// @ts-nocheck` — so new JS is checked by default, the
  // inverse of the old opt-in `// @ts-check` model. The remaining un-migrated
  // files carry `@ts-nocheck`; the `@ts-nocheck` ratchet (scripts/ratchets.mjs)
  // drives that count to zero as files are typed or migrated to .ts.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Stricter than `strict` bundles. The big one is noUncheckedIndexedAccess:
    // every arr[i] / record[key] becomes `T | undefined`, which forces the
    // gap to be handled at the source instead of surfacing as `undefined`
    // deep in a component. The rest close small holes `strict` leaves open.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // Vite owns transpilation; tsc is type-check only.
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", ".vite"]
}
