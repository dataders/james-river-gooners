{
  // Initial TypeScript harness. The codebase is still mostly .js/.jsx with
  // JSDoc types (see src/types.ts and the `// @ts-check` files). This config
  // type-checks two things without forcing a big-bang migration:
  //   1. real .ts/.tsx files (start: src/types.ts), and
  //   2. .js files that individually opt in with a `// @ts-check` comment.
  // `checkJs` stays OFF so the ~80 un-annotated .js/.jsx files don't redden CI;
  // flip it to true (or migrate files to .ts) to widen coverage incrementally.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Stricter than `strict` bundles. The big one is noUncheckedIndexedAccess:
    // every arr[i] / record[key] becomes `T | undefined`, which forces the
    // gap to be handled at the source instead of surfacing as `undefined`
    // deep in a component. The rest close small holes `strict` leaves open.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // Vite owns transpilation; tsc is type-check only.
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", ".vite"]
}
